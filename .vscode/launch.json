{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Flutter Web (Mac, Linux)",
      "cwd": "${workspaceFolder}/frontend",
      "request": "launch",
      "type": "dart",
      "args": [
        "-d",
        "chrome",
        "--web-port",
        "8080",
      ]
    },
    {
      "name": "Flutter Web (Windows)",
      "cwd": "${workspaceFolder}/frontend",
      "request": "launch",
      "type": "dart",
      "args": [
        "-d",
        "web-server",
        "--web-port",
        "8080",
        "--dart-define=SUPABASE_URL=https://localhost:8443",
      ]
    }
  ]
}