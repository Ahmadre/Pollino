############################################
# Pollino - Environment Configuration
# Copy this file to .env and adjust values
#   cp .env.example .env
############################################


############
# MongoDB - Database
############

MONGODB_USER=pollino
MONGODB_PASSWORD=pollino_secret
MONGODB_DATABASE=pollino
MONGODB_PORT=27017

# Uncomment for Debugging
# Composite URI for Spring Boot (used by application.yml)
# Use this ONLY for Debugging with .env.local - in production, construct URI from individual components for better security
# MONGODB_URI=mongodb://pollino:pollino_secret@localhost:27017/pollino?authSource=admin

############
# Backend - Spring Boot API
############

BACKEND_PORT=8080

# API Key for authenticated endpoints (CHANGE IN PRODUCTION!)
API_KEY=changeme-generate-secure-key

# CORS - comma-separated origins, or * for all
CORS_ALLOWED_ORIGINS=*

# Automatic cleanup of expired polls
CLEANUP_ENABLED=true
CLEANUP_CRON=0 0 * * * *

# Rate Limiting (requests per minute)
RATE_LIMIT_RPM=60
RATE_LIMIT_VOTE_RPM=10

# Logging level (DEBUG, INFO, WARN, ERROR)
LOG_LEVEL=INFO

# JVM Memory (adjust for production)
# JAVA_OPTS=-Xmx512m -Xms256m


############
# Frontend - Flutter Web App
############

FRONTEND_PORT=3001

# Public URL where the frontend is accessible
WEB_APP_URL=http://localhost:3001

# Backend API URL (as seen by the browser / client)
API_BASE_URL=http://localhost:8080

############
# Email - SMTP Configuration
############

SMTP_HOST="smtp.domain.com"
SMTP_PORT="465"
SMTP_USERNAME="mail@domain.com"
SMTP_PASSWORD=""
SMTP_SENDER="Pollino <poll@domain.com>"
MAIL_ENABLED="true"